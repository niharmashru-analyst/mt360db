# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real links/secrets.

# Your OneDrive/SharePoint sharing link to the main data Excel file.
# Get this via: right-click file in OneDrive > Share > "Anyone with the link" > Copy Link
# Paste the sharing link as-is — the server automatically converts it to a
# direct-download link (see toDirectDownloadUrl() in server.js).
ONEDRIVE_EXCEL_URL=

# Optional — only needed once you wire up the separate Distribution Master file.
# ONEDRIVE_DISTRIBUTION_URL=

# --- Month-on-month files (one file per month, same columns) ---
# Option A: drop the files in the data/ folder (2026-07.xlsx, 2026-08.xlsx ...). Use a PRIVATE repo.
# Option B: one share link per month, comma- or line-separated (replaces ONEDRIVE_EXCEL_URL):
# ONEDRIVE_EXCEL_URLS=https://.../jul.xlsx,https://.../aug.xlsx
# Safety limit on total rows (every row is sent to the browser):
# MAX_ROWS=400000
